# ============================================
# Albertsons Store ETL Environment Configuration
# Last updated: 2026-04-30 by rgonzalez
#
# Sourced by nearly every script in scripts/ and utils/.
# WARNING: plaintext credentials live here. This file is chmod 600 on
#          the VMs but is otherwise unmanaged (no Vault / Secret Manager).
# ============================================

# --------------------------------------------
# Vendor POS API (store sales feed)
# --------------------------------------------
POS_API_BASE_URL="https://api.retailfeed-vendor.com/v2"
POS_API_KEY="albpos-9f3ac21b7e6d4c88a05f1e2d3c4b5a60"
POS_API_TIMEOUT=30
POS_API_RETRY_COUNT=3

# --------------------------------------------
# Snowflake warehouse (LEGACY - DECOMMISSIONED 2026-Q2)
# --------------------------------------------
# FIXME(migration): The Snowflake account below was turned off after the
# Snowflake -> BigQuery migration. These vars are still referenced by
# extract_from_snowflake.sh, load_warehouse.sh and utils/snowflake_helpers.sh,
# which is why the nightly extract/load steps now fail. Do NOT rely on these.
SNOWFLAKE_ACCOUNT="alb_prod.us-east-1"
SNOWFLAKE_USER="ETL_SVC"
SNOWFLAKE_PASSWORD="Sn0wf@ll_Etl_2024!"
SNOWFLAKE_WAREHOUSE="ETL_WH"
SNOWFLAKE_DATABASE="RETAIL_PROD"
SNOWFLAKE_SCHEMA="STORE_OPS"
SNOWFLAKE_ROLE="ETL_ROLE"
SNOWSQL_CONFIG="/opt/albertsons/etl/.snowsql/config"
# Legacy ODBC DSN used by a couple of ad-hoc reporting scripts
SNOWFLAKE_ODBC_DSN="SF_RETAIL_PROD"

# --------------------------------------------
# BigQuery (NEW - added during migration, NOT yet wired into scripts)
# --------------------------------------------
# TODO(migration): These were added when the data landed in BigQuery, but the
# Bash scripts were never updated to use them. The Python rewrite should read
# these and drop all SNOWFLAKE_* vars above.
GCP_PROJECT="albertsons-retail-analytics"
GCP_REGION="us-central1"
BQ_DATASET="store_ops"
BQ_LOCATION="US"
GOOGLE_APPLICATION_CREDENTIALS="/opt/albertsons/etl/.gcp/etl-sa.json"
GCS_BUCKET="albertsons-etl-landing"

# --------------------------------------------
# File Paths (hardcoded on the GCE VMs)
# --------------------------------------------
ETL_HOME="/opt/albertsons/etl"
DATA_INPUT_DIR="/opt/albertsons/etl/data/incoming"
DATA_OUTPUT_DIR="/opt/albertsons/etl/data/processed"
DATA_STAGING_DIR="/opt/albertsons/etl/data/staging"
DATA_ARCHIVE_DIR="/opt/albertsons/etl/data/archive"
DATA_ERROR_DIR="/opt/albertsons/etl/data/errors"

# Network share where archives are also dropped (NFS mount, flaky)
ARCHIVE_SHARE="/mnt/nas/retail-etl/archive"

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_DIR="/var/log/albertsons/etl"
LOG_LEVEL="INFO"
LOG_RETENTION_DAYS=45

# --------------------------------------------
# Alerting
# --------------------------------------------
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T0AB1/B2CD3/eFgHiJkLmNoPqRsTuVwXyZ12"
ALERT_EMAIL="store-data-ops@albertsons.com"

# --------------------------------------------
# Processing knobs
# --------------------------------------------
CSV_DELIMITER=","
BATCH_SIZE=20000
RETENTION_DAYS=30
