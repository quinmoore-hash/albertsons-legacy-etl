# ============================================
# Albertsons Store ETL Environment Configuration
#
# Read by etl/config.py (KEY=value; env vars override these values).
#
# Credentials are NO LONGER stored here. The POS API key and Slack webhook
# now live in Google Secret Manager and are fetched at runtime by
# etl/secrets.py (see *_SECRET ids below). All Snowflake settings were removed
# in the 2026-Q2 Snowflake -> BigQuery migration.
# ============================================

# --------------------------------------------
# Vendor POS API (store sales feed)
# --------------------------------------------
POS_API_BASE_URL="https://api.retailfeed-vendor.com/v2"
POS_API_TIMEOUT=30
POS_API_RETRY_COUNT=3
# Secret Manager secret id holding the POS API key (X-Api-Key header).
POS_API_KEY_SECRET="pos-api-key"

# --------------------------------------------
# BigQuery / GCP (the warehouse target)
# --------------------------------------------
GCP_PROJECT="albertsons-retail-analytics"
GCP_REGION="us-central1"
BQ_DATASET="store_ops"
BQ_LOCATION="US"
GCS_BUCKET="albertsons-etl-landing"
# Application Default Credentials are used when running on GCP (Composer /
# Cloud Run). For local runs, point GOOGLE_APPLICATION_CREDENTIALS at a key
# file in the environment, not here.

# --------------------------------------------
# Working directories
# Defaults (used when unset) are repo-relative: data/incoming, data/staging,
# data/processed, data/archive, data/errors. Override for on-prem/GCE layouts.
# --------------------------------------------
# DATA_INPUT_DIR="/opt/albertsons/etl/data/incoming"
# DATA_OUTPUT_DIR="/opt/albertsons/etl/data/processed"
# DATA_STAGING_DIR="/opt/albertsons/etl/data/staging"
# DATA_ARCHIVE_DIR="/opt/albertsons/etl/data/archive"
# DATA_ERROR_DIR="/opt/albertsons/etl/data/errors"

# --------------------------------------------
# Logging (default log dir is repo-relative ./logs)
# --------------------------------------------
# LOG_DIR="/var/log/albertsons/etl"
LOG_LEVEL="INFO"
LOG_RETENTION_DAYS=45

# --------------------------------------------
# Alerting (webhook is a Secret Manager id; routing is non-secret)
# --------------------------------------------
SLACK_WEBHOOK_SECRET="slack-webhook-url"
ALERT_EMAIL="store-data-ops@albertsons.com"
SMTP_HOST="smtp.albertsons.internal"
SMTP_PORT=587
SMTP_FROM="store-etl-alerts@albertsons.com"

# --------------------------------------------
# Processing knobs
# --------------------------------------------
BATCH_SIZE=20000
RETENTION_DAYS=30
